diff --git a/crates/engine/src/cmd/external_images.rs b/crates/engine/src/cmd/external_images.rs
new file mode 100644
index 0000000000000000000000000000000000000000..f30f7874d25cfb26216eaa27b004d994b55bc842
--- /dev/null
+++ b/crates/engine/src/cmd/external_images.rs
@@ -0,0 +1,176 @@
+//! Host-supplied bytes for ordinary relative image links. No network access.
+use super::*;
+use serde_json::json;
+use std::collections::BTreeSet;
+use std::sync::Arc;
+use vectorcraft_doc::{LinkInfo, NodeKind, links::hash_bytes};
+
+pub fn specs() -> Vec<CommandSpec> {
+    vec![
+        cmd!(
+            "links.openExternal",
+            "Open External Image",
+            [],
+            None,
+            "{reference, path? | name?, dataBase64?} open raster bytes as a new document linked to a relative filename; the host supplies bytes, never a URL fetch",
+            always,
+            open
+        ),
+        cmd!(query "links.external", "External Images", [], None,
+            "{} list unresolved external images across open documents → {references: [reference]}", always, pending),
+        cmd!(
+            "links.supplyExternal",
+            "Supply External Image",
+            [],
+            None,
+            "{reference, path? | name?, dataBase64?} supply immutable image bytes to matching references across open documents; verifies saved hashes and image keys without making an edit → {resolved}",
+            always,
+            supply
+        ),
+    ]
+}
+
+fn reference<'a>(p: &'a Value, cmd: &str) -> Result<&'a str> {
+    let r = str_param(p, "reference").ok_or_else(|| bad(cmd, "missing reference"))?;
+    if r.is_empty() || r.len() > 255 || r == "." || r == ".." || !r.bytes().all(|b| b.is_ascii_alphanumeric() || b"._-".contains(&b)) {
+        return Err(bad(cmd, "expected a relative filename"));
+    }
+    Ok(r)
+}
+
+fn check_size(p: &Value) -> Result<()> {
+    if str_param(p, "dataBase64").is_some_and(|b| b.len() > 90 * 1024 * 1024) {
+        return Err(bad("links.external", "image exceeds 64 MiB"));
+    }
+    Ok(())
+}
+
+fn open(s: &mut Session, p: &Value) -> Result<Value> {
+    let r = reference(p, "links.openExternal")?;
+    check_size(p)?;
+    let src = fileio::source(p, "links.openExternal")?;
+    if src.bytes.len() > 64 * 1024 * 1024 {
+        return Err(bad("links.external", "image exceeds 64 MiB"));
+    }
+    let img = fileio::raster_image(&src.bytes)?;
+    let result = fileio::open_bytes(s, src.name, &src.bytes, None)?;
+    let st = s.doc_mut()?;
+    let d = Arc::make_mut(&mut st.doc);
+    let mut ids = vec![];
+    d.visit_images(|n, _| ids.push(n.id));
+    for id in ids {
+        if let Some(n) = d.node_mut(id)
+            && let NodeKind::Image(im) = &mut n.kind
+        {
+            im.link =
+                Some(LinkInfo { path: r.into(), hash: Some(hash_bytes(&src.bytes)), size: Some(src.bytes.len() as u64), ..LinkInfo::default() });
+        }
+    }
+    super::links::store_image(d, &img.key, img.blob, true);
+    st.revision += 1;
+    Ok(result)
+}
+
+fn pending(s: &mut Session, _: &Value) -> Result<Value> {
+    let mut refs = BTreeSet::new();
+    for st in s.documents() {
+        st.doc.visit_images(|_, im| {
+            if let Some(l) = &im.link
+                && st.doc.images.get(&im.key).is_none_or(|b| b.is_proxy())
+            {
+                refs.insert(l.path.clone());
+            }
+        });
+    }
+    Ok(json!({"references": refs}))
+}
+
+fn supply(s: &mut Session, p: &Value) -> Result<Value> {
+    let r = reference(p, "links.supplyExternal")?;
+    check_size(p)?;
+    let src = fileio::source(p, "links.supplyExternal")?;
+    let hash = hash_bytes(&src.bytes);
+    if src.bytes.len() > 64 * 1024 * 1024 {
+        return Err(bad("links.external", "image exceeds 64 MiB"));
+    }
+    let img = fileio::raster_image(&src.bytes)?;
+    let mut targets = vec![];
+    for st in s.documents() {
+        let mut found = false;
+        let mut invalid = false;
+        st.doc.visit_images(|_, im| {
+            if let Some(l) = &im.link
+                && l.path == r
+            {
+                found = true;
+                invalid |= l.hash.as_deref() != Some(&hash) || im.key != img.key;
+            }
+        });
+        if invalid {
+            return Err(bad("links.supplyExternal", "external image checksum mismatch"));
+        }
+        if found {
+            targets.push(st.uid);
+        }
+    }
+    for uid in &targets {
+        if let Some(st) = s.document_mut(*uid) {
+            st.change_unsaved(|d| super::links::store_image(Arc::make_mut(d), &img.key, img.blob.clone(), true));
+            st.revision += 1;
+        }
+    }
+    Ok(json!({"resolved": targets.len()}))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::tests_links::png;
+
+    #[test]
+    fn ordinary_link_loads_with_stock_resolver() {
+        let folder = crate::tests_links::Folder::new("ordinary-sibling");
+        let bytes = png(512, 512, [20, 40, 60]);
+        let reference = "401000054.V.0.png";
+        let mut s = Session::new();
+        open(&mut s, &json!({"reference":reference,"name":reference,"dataBase64":vectorcraft_format::base64_encode(&bytes)})).unwrap();
+        s.doc().unwrap().doc.visit_images(|_, im| assert_eq!(im.link.as_ref().unwrap().path, reference));
+        let saved = vectorcraft_format::save(&s.doc().unwrap().doc, false);
+        std::fs::write(folder.file(reference), &bytes).unwrap();
+        let mut reopened = Session::new();
+        fileio::open_bytes(&mut reopened, "Test.vectorcraft", &saved, Some(folder.file("Test.vectorcraft"))).unwrap();
+        assert_eq!(pending(&mut reopened, &json!({})).unwrap()["references"], json!([]));
+        assert!(!reopened.doc().unwrap().is_dirty());
+        for invalid in ["../x.png", "/x.png", "https://host/x.png", "asset:dings:1.V.0.png"] {
+            assert!(open(&mut s, &json!({"reference":invalid,"dataBase64":""})).is_err());
+        }
+    }
+
+    #[test]
+    fn external_images_roundtrip_and_hash_guard() {
+        let bytes = png(512, 512, [20, 40, 60]);
+        let data = vectorcraft_format::base64_encode(&bytes);
+        let reference = "picture.V.1.png";
+        let mut s = Session::new();
+        open(&mut s, &json!({"reference":reference, "name":"picture.png", "dataBase64":data})).unwrap();
+        s.execute("select.all", &json!({})).unwrap();
+        s.execute("edit.copy", &json!({})).unwrap();
+        s.execute("file.new", &json!({})).unwrap();
+        s.execute("edit.paste", &json!({})).unwrap();
+        let mut links = vec![];
+        s.doc().unwrap().doc.visit_images(|_, im| links.push(im.link.as_ref().unwrap().path.clone()));
+        assert_eq!(links, vec![reference]);
+        let saved = vectorcraft_format::save(&s.doc().unwrap().doc, false);
+        let mut reopened = Session::new();
+        fileio::open_bytes(&mut reopened, "picture.vectorcraft", &saved, None).unwrap();
+        assert_eq!(pending(&mut reopened, &json!({})).unwrap()["references"], json!([reference]));
+        let wrong = vectorcraft_format::base64_encode(&png(512, 512, [90, 20, 10]));
+        assert!(supply(&mut reopened, &json!({"reference":reference,"dataBase64":wrong})).is_err());
+        let dirty = reopened.doc().unwrap().is_dirty();
+        assert_eq!(supply(&mut reopened, &json!({"reference":reference,"dataBase64":data})).unwrap()["resolved"], 1);
+        assert_eq!(pending(&mut reopened, &json!({})).unwrap()["references"], json!([]));
+        assert_eq!(reopened.doc().unwrap().is_dirty(), dirty);
+        let saved_again = vectorcraft_format::save(&reopened.doc().unwrap().doc, false);
+        assert_eq!(saved, saved_again);
+    }
+}
